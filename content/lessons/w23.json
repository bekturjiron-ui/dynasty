    "solo": {
      "prompt": "{{p2.short}}: прибыль с продажи сейчас {{(p2.price*(1-fee-tax-pack)-p2.delivery-p2.inbound-p2.cost)|tg}}. После работы над закупом маржа {{m}}% от цены. Продаж в месяц {{p2.orders}}. Эффект за год?",
      "inputs": {
        "m": 14
      },
      "answerFormula": "(p2.price*m/100-(p2.price*(1-fee-tax-pack)-p2.delivery-p2.inbound-p2.cost))*p2.orders*12",
      "hints": [
        "(Цена × маржа/100 − прибыль сейчас) × продаж в месяц × 12."
      ],
      "report": {
        "ok": "Эффект {{correct|tg}} в год. Это число идёт в строку резюме рядом с названием кейса.",
        "off": "В докладе {{answer|tg}}. Советник: «Прирост прибыли с продажи умножаем на продажи в месяц и на 12»."
      }
    },
    "arsenalCard": {
      "title": "Кейс «до/после»",
      "body": "До, После, Эффект в год.\nПрирост с продажи = После − До.\nЭффект в год = Прирост × Продаж в мес × 12.\nЦифры из своей таблицы."
    },
