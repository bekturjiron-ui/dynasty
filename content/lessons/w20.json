          "unit": "pct",
          "hint": "Прибыль / выручка."
        }
      ],
      "answerFormula": "(q5*(p5.price*(1-fee-tax-pack)-p5.delivery-p5.inbound-p5.cost)+q7*(p7.price*(1-fee-tax-pack)-p7.delivery-p7.inbound-p7.cost)+q2*(p2.price*(1-fee-tax-pack)-p2.delivery-p2.inbound-p2.cost))/(q5*p5.price+q7*p7.price+q2*p2.price)",
      "unit": "pct",
