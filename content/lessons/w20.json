      "rev": "2*p1.price+p2.price+p3.price+p6.price",
      "pr": "2*(p1.price*(1-fee-tax-pack)-p1.delivery-p1.inbound-p1.cost)+(p2.price*(1-fee-tax-pack)-p2.delivery-p2.inbound-p2.cost)+(p3.price*(1-fee-tax-pack)-p3.delivery-p3.inbound-p3.cost)+(p6.price*(1-fee-tax-pack)-p6.delivery-p6.inbound-p6.cost)",
      "mar": "(2*(p1.price*(1-fee-tax-pack)-p1.delivery-p1.inbound-p1.cost)+(p2.price*(1-fee-tax-pack)-p2.delivery-p2.inbound-p2.cost)+(p3.price*(1-fee-tax-pack)-p3.delivery-p3.inbound-p3.cost)+(p6.price*(1-fee-tax-pack)-p6.delivery-p6.inbound-p6.cost))/(2*p1.price+p2.price+p3.price+p6.price)"
    },
