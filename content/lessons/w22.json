    "skill": "analytics",
    "title": "Цель квартала: от базы к цели",
    "why": "Цель без расчёта — это пожелание. Цель квартала строится так: берём базу, находим рычаги, считаем, сколько каждый даёт, и только потом называем цифру.",
    "vars": {
      "mp": "p1.orders*(p1.price*(1-fee-tax-pack)-p1.delivery-p1.inbound-p1.cost)+p2.orders*(p2.price*(1-fee-tax-pack)-p2.delivery-p2.inbound-p2.cost)+p3.orders*(p3.price*(1-fee-tax-pack)-p3.delivery-p3.inbound-p3.cost)+p4.orders*(p4.price*(1-fee-tax-pack)-p4.delivery-p4.inbound-p4.cost)+p5.orders*(p5.price*(1-fee-tax-pack)-p5.delivery-p5.inbound-p5.cost)+p6.orders*(p6.price*(1-fee-tax-pack)-p6.delivery-p6.inbound-p6.cost)+p7.orders*(p7.price*(1-fee-tax-pack)-p7.delivery-p7.inbound-p7.cost)+p8.orders*(p8.price*(1-fee-tax-pack)-p8.delivery-p8.inbound-p8.cost)",
      "qb": "3*(p1.orders*(p1.price*(1-fee-tax-pack)-p1.delivery-p1.inbound-p1.cost)+p2.orders*(p2.price*(1-fee-tax-pack)-p2.delivery-p2.inbound-p2.cost)+p3.orders*(p3.price*(1-fee-tax-pack)-p3.delivery-p3.inbound-p3.cost)+p4.orders*(p4.price*(1-fee-tax-pack)-p4.delivery-p4.inbound-p4.cost)+p5.orders*(p5.price*(1-fee-tax-pack)-p5.delivery-p5.inbound-p5.cost)+p6.orders*(p6.price*(1-fee-tax-pack)-p6.delivery-p6.inbound-p6.cost)+p7.orders*(p7.price*(1-fee-tax-pack)-p7.delivery-p7.inbound-p7.cost)+p8.orders*(p8.price*(1-fee-tax-pack)-p8.delivery-p8.inbound-p8.cost))",
      "lev": "(p1.cost-(p1.price*((1-fee-tax-pack)-0.05)-p1.delivery))*p1.orders*3",
      "g": "((p1.cost-(p1.price*((1-fee-tax-pack)-0.05)-p1.delivery))*p1.orders*3)/(3*(p1.orders*(p1.price*(1-fee-tax-pack)-p1.delivery-p1.inbound-p1.cost)+p2.orders*(p2.price*(1-fee-tax-pack)-p2.delivery-p2.inbound-p2.cost)+p3.orders*(p3.price*(1-fee-tax-pack)-p3.delivery-p3.inbound-p3.cost)+p4.orders*(p4.price*(1-fee-tax-pack)-p4.delivery-p4.inbound-p4.cost)+p5.orders*(p5.price*(1-fee-tax-pack)-p5.delivery-p5.inbound-p5.cost)+p6.orders*(p6.price*(1-fee-tax-pack)-p6.delivery-p6.inbound-p6.cost)+p7.orders*(p7.price*(1-fee-tax-pack)-p7.delivery-p7.inbound-p7.cost)+p8.orders*(p8.price*(1-fee-tax-pack)-p8.delivery-p8.inbound-p8.cost)))",
      "lim": "(p1.price*((1-fee-tax-pack)-0.05)-p1.delivery)"
    },
    "demo": [
      {
        "text": "База — то, что магазин приносит сейчас. Прибыль Novelia в месяц около {{mp|tg}}, за квартал {{qb|tg}}. Это точка, от которой считаем.",
        "table": [
          [
            "Статья",
            "₸"
          ],
          [
            "Прибыль в месяц",
            "$round(mp)"
          ],
          [
            "Месяцев",
            3
          ],
          [
            "Прибыль квартала",
            "=B2*B3"
          ]
        ],
        "highlight": [
          "B4"
        ]
      },
      {
        "text": "Рычаг — действие с расчётным эффектом. Например, договориться о закупе {{p1.short}} до границы {{lim|tg}} (из недели 16). Это {{p1.cost|tg}} − {{lim|tg}} за штуку на {{p1.orders}} продаж в месяц, на три месяца: {{lev|tg}}.",
        "table": [
          [
            "Статья",
            "Значение"
          ],
