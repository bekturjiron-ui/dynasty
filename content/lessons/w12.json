          [
            "Статья",
            "Значение"
          ],
          [
            "Оценок",
            "$n"
          ],
          [
            "Цель − сейчас",
            "$round(t-r,1)"
          ],
          [
            "5 − цель",
            "$5-t"
          ],
          [
