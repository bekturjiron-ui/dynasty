            "effect": {
              "loyalty": 5,
              "patience": -5
            },
            "next": "terms"
          },
          {
            "text": "Мне нужна цена ниже 6 000 ₸, иначе работать не будем.",
            "tactic": "pressure",
            "effect": {
              "price": 6,
              "loyalty": -15,
              "patience": -15
            },
            "next": "ceiling"
