    "nodes": [
      {
        "id": "open",
        "npcLine": "Здравствуйте! Это Асель из «K-Beauty Trade». Вижу, {{product.short}} у вас хорошо уходит. Готовы к следующей партии? Цена прежняя — {{start|tg}} за штуку.",
        "options": [
          {
            "text": "Здравствуйте, Асель! Да, за два месяца ушло {{sold}} штук. Хочу обсудить условия на партию побольше.",
            "tactic": "info",
            "effect": {
              "loyalty": 5
            },
            "next": "volume"
          },
          {
            "text": "Цена высокая. У других дешевле — снижайте.",
            "tactic": "pressure",
            "effect": {
              "loyalty": -10,
              "patience": -10
            },
            "next": "competitors"
          },
          {
            "text": "Сколько скидки дадите, если возьму {{volume}} штук?",
