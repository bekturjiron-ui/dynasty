[
  {
    "id": "w16-neg",
    "week": 17,
    "title": "Закуп Dr.Hana: вернуть маржу",
    "intro": "{{product.short}} — лидер продаж Novelia, но с каждой продажи остаётся всего {{left|tg}}. Чтобы маржа дошла до 5%, закуп должен опуститься с {{start|tg}} до {{target|tg}}. Сегодня звонит поставщик. Цель — цена не выше этой черты и партнёр, который захочет работать дальше.",
    "supplier": {
      "name": "Асель",
      "company": "K-Beauty Trade",
      "role": "менеджер дистрибьютора"
    },
    "product": "p1",
    "vars": {
      "left": "p1.price*(1-fee-tax-pack)-p1.delivery-p1.cost",
