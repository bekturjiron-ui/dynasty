            "effect": {
              "loyalty": 10,
              "patience": -5
            },
            "next": "honest"
          },
          {
            "text": "Серый импорт на Kaspi дешевле на 15%.",
            "tactic": "pressure",
            "effect": {
              "loyalty": -5,
              "patience": -10
