    "startPrice": "p1.cost",
    "maxDiscountPct": 9,
    "volume": 30,
    "orders": 3,
    "loyalty": 60,
    "patience": 100,
    "coldBelow": 35,
    "replacementMarkup": 1.05,
    "start": "open",
    "reward": {
      "xp": 150,
      "influence": 40
