        "id": "last",
        "npcLine": "Хорошо. Последнее предложение: {{price|tg}} за штуку. Но этот разговор я запомню.",
        "options": [
          {
            "text": "Беру.",
            "tactic": "pressure",
            "effect": {
              "loyalty": -10
            },
            "next": "$deal"
